# Public Supabase project credentials (safe for the browser; RLS is mandatory)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Canonical URL used for auth redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set to "true" only for a fully configured production environment
NEXT_PUBLIC_SUPABASE_ENABLED=true
